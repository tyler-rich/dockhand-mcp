{
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(uv run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr edit:*)",
      "Bash(python3 scripts/gen-endpoint-map.py:*)",
      "Bash(docker build:*)",
      "Bash(docker run --rm:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git ls-remote:*)",
      "Bash(git config --get:*)",
      "Bash(git config user.name)",
      "Bash(git config user.email)",
      "Bash(gh release view:*)",
      "Bash(docker buildx imagetools inspect:*)",
      "WebFetch",
      "WebSearch",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(pip install:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(docker run -v /var/run/docker.sock:*)",
      "Read(./secrets/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Write(./secrets/**)",
      "Bash(gh pr create --base main:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(gh repo edit:*)",
      "Bash(git config --global:*)"
    ]
  }
}
