# dockhand-mcp configuration. Every variable, with its default and a one-line explanation.
# Secrets belong in files (the *_FILE variants) or your platform's secret store — never here.
# An empty value means "unset".

# --- DockHand -----------------------------------------------------------------------------------
# Base URL of DockHand (required). Absolute; https unless DOCKHAND_ALLOW_HTTP=true.
DOCKHAND_URL=https://dockhand.example.test
# Allow an http:// DOCKHAND_URL (plain HTTP to DockHand; use only on a trusted network).
DOCKHAND_ALLOW_HTTP=false
# dh_ API token of a dedicated DockHand user, read from a file (preferred). Set only one of the pair.
DOCKHAND_TOKEN_FILE=/run/secrets/dockhand_token
# dh_ API token as a value (only where the platform injects it from an encrypted store).
DOCKHAND_TOKEN=
# PEM bundle for a private CA that signs DockHand's certificate.
DOCKHAND_CA_BUNDLE=
# Disable TLS verification of DockHand. Logs a warning on every startup.
DOCKHAND_TLS_INSECURE=false
# Environment used when a tool call omits environment_id.
DOCKHAND_DEFAULT_ENVIRONMENT_ID=

# --- Tool exposure ------------------------------------------------------------------------------
# read-only | operator | admin. Tools above the profile are never registered.
DOCKHAND_MCP_PROFILE=read-only
# Comma list of tool names to remove from the profile.
DOCKHAND_MCP_DISABLE_TOOLS=

# --- Transport ----------------------------------------------------------------------------------
# http | stdio.
DOCKHAND_MCP_TRANSPORT=http
# Listen address. 127.0.0.1 outside Docker; the reference compose uses 0.0.0.0 inside the container.
DOCKHAND_MCP_BIND=127.0.0.1
# Listen port.
DOCKHAND_MCP_PORT=8080
# URL path of the MCP endpoint.
DOCKHAND_MCP_PATH=/mcp

# --- MCP authentication -------------------------------------------------------------------------
# bearer | oauth (Phase 5) | none (stdio, or loopback HTTP with ALLOW_UNAUTHENTICATED=true).
DOCKHAND_MCP_AUTH_MODE=bearer
# Bearer token clients must send, from a file (preferred); at least 43 characters.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
DOCKHAND_MCP_TOKEN_FILE=/run/secrets/mcp_token
# Bearer token as a value. Set only one of the pair.
DOCKHAND_MCP_TOKEN=
# Required (with a loopback bind) for AUTH_MODE=none over HTTP.
DOCKHAND_MCP_ALLOW_UNAUTHENTICATED=false

# --- HTTP hardening -----------------------------------------------------------------------------
# Host-header allow-list (DNS-rebinding protection). A host without a port matches any port.
DOCKHAND_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Origin allow-list for browser clients, e.g. https://mcp.example.test. Empty = no browser origins.
DOCKHAND_MCP_ALLOWED_ORIGINS=
# Honour the right-most X-Forwarded-For entry for rate limiting. Only behind your own proxy.
DOCKHAND_MCP_TRUST_PROXY=false
# Requests per minute per client IP.
DOCKHAND_MCP_RATE_LIMIT_PER_MIN=120

# --- Waits --------------------------------------------------------------------------------------
# Default seconds a wait=true tool call waits for a DockHand operation.
DOCKHAND_MCP_DEFAULT_TIMEOUT=60
# Upper bound for timeout_seconds (at most 300).
DOCKHAND_MCP_MAX_TIMEOUT=300

# --- Logging ------------------------------------------------------------------------------------
# debug | info | warning | error.
DOCKHAND_MCP_LOG_LEVEL=info
# json | text. Logs go to stderr.
DOCKHAND_MCP_LOG_FORMAT=json

# --- Guardrails and destructive-call approval ---------------------------------------------------
# strict (refuse on errors) | warn (report findings). There is no "off".
DOCKHAND_MCP_GUARDRAILS=strict
# Comma list of extra absolute bind-mount source prefixes to allow. /, the Docker socket, /etc,
# /proc, /sys, /dev, /boot and /var/lib/docker can never be allowed.
DOCKHAND_MCP_GUARDRAIL_ALLOW_BIND=
# auto (elicitation when the client supports it, else confirm) | elicitation | param.
DOCKHAND_MCP_CONFIRM_MODE=auto
# HMAC key for approval challenges, at least 32 bytes, from a file. Unset = random per process.
DOCKHAND_MCP_CHALLENGE_KEY_FILE=
# HMAC key as a value. Set only one of the pair.
DOCKHAND_MCP_CHALLENGE_KEY=
# Destructive calls per minute per principal.
DOCKHAND_MCP_DESTRUCTIVE_PER_MIN=10
# Allow the admin profile with DOCKHAND_TLS_INSECURE=true. Deliberately ugly; avoid.
DOCKHAND_MCP_I_UNDERSTAND_ADMIN_OVER_INSECURE_TLS=false

# DOCKHAND_MCP_RESOURCE_URL and DOCKHAND_MCP_OAUTH_* are reserved for Phase 5 and ignored today.
