  {"tool": "dockhand_get_all_container_stats", "args": {"environment_id": "${env}", "limit": 5}, "expect": {"ok": true}},
  {"tool": "dockhand_get_container_processes", "args": {"environment_id": "${env}", "ref": "${container}"}, "expect": {"ok": true}},
