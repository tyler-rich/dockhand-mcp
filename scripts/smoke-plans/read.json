  {"tool": "dockhand_generate_container_compose", "args": {"environment_id": "${env}", "ref": "${container}"}, "expect": {"ok": true, "equals": {"data.env_redacted": true}}},
  {"tool": "dockhand_get_pending_updates", "args": {"environment_id": "${env}"}, "expect": {"ok": true}},
