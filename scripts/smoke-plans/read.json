  {"tool": "dockhand_get_stack_env_raw", "args": {"environment_id": "${env}", "stack": "${stack}"}, "expect": {"ok": true}},
  {"tool": "dockhand_list_stack_deploys", "args": {"environment_id": "${env}", "stack": "${stack}", "limit": 5}, "expect": {"ok": true}, "save": {"run_id": {"path": "data.items.0.id", "default": 1}}},
  {"tool": "dockhand_get_stack_deploy_log", "args": {"stack": "${stack}", "run_id": "${run_id}", "max_bytes": 8192}, "expect": {"any_of": [{"ok": true}, {"error.code": "not_found"}]}},
  {"tool": "dockhand_preview_stack_delete", "args": {"environment_id": "${env}", "stack": "${stack}"}, "expect": {"ok": true}},
  {"tool": "dockhand_validate_stack_compose", "args": {"environment_id": "${env}", "stack": "${stack}", "compose": "services:\n  web:\n    image: nginx:1.27\n", "existing": true}, "expect": {"ok": true}},
  {"tool": "dockhand_validate_stack_env", "args": {"environment_id": "${env}", "stack": "${stack}"}, "expect": {"ok": true}},
  {"tool": "dockhand_get_stack_paths", "args": {"environment_id": "${env}", "stack": "${stack}"}, "expect": {"ok": true}},

  {"tool": "dockhand_list_images", "args": {"environment_id": "${env}", "limit": 1}, "expect": {"ok": true}, "save": {"image": "data.items.0.id"}},
