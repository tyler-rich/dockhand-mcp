  {"tool": "dockhand_list_stacks", "args": {"environment_id": "${env}", "limit": 500}, "expect": {"ok": true}, "save": {"stack": {"path": "data.items", "pick": {"field": "name", "skip_prefix": "mcp-smoke-", "probe": {"tool": "dockhand_get_stack_compose", "args": {"environment_id": "${env}", "stack": "${candidate}"}, "expect": {"ok": true}}}}}},
  {"tool": "dockhand_get_stack_compose", "args": {"environment_id": "${env}", "stack": "${stack}"}, "expect": {"ok": true}},
