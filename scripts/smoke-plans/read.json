  {"tool": "dockhand_get_schedule_execution", "args": {"execution_id": "${execution}", "max_bytes": 8192}, "expect": {"ok": true}},
  {"tool": "dockhand_get_auto_update_settings", "args": {"environment_id": "${env}"}, "expect": {"ok": true}},
  {"tool": "dockhand_get_auto_update_settings", "args": {"environment_id": "${env}", "container_name": "${container}"}, "expect": {"ok": true}},

  {"tool": "dockhand_list_vulnerabilities", "args": {"environment_id": "${env}", "limit": 5}, "expect": {"ok": true}},
  {"tool": "dockhand_get_vulnerability_summary", "args": {"environment_id": "${env}"}, "expect": {"ok": true}},

  {"tool": "dockhand_list_registries", "expect": {"ok": true}},
  {"tool": "dockhand_search_registry", "args": {"term": "nginx", "limit": 3}, "expect": {"ok": true}},
  {"tool": "dockhand_list_image_tags", "args": {"image": "library/nginx", "page_size": 5}, "expect": {"ok": true}},

  {"tool": "dockhand_get_settings", "args": {"environment_id": "${env}"}, "expect": {"ok": true}},
  {"tool": "dockhand_list_git_repositories", "expect": {"ok": true}},
