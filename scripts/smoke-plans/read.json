  {"tool": "dockhand_get_volume", "args": {"environment_id": "${env}", "volume": "${volume}"}, "expect": {"ok": true}},
  {"tool": "dockhand_list_networks", "args": {"environment_id": "${env}"}, "expect": {"ok": true}, "save": {"network": "data.items.0.name"}},
  {"tool": "dockhand_get_network", "args": {"environment_id": "${env}", "network": "${network}"}, "expect": {"ok": true}},

  {"tool": "dockhand_get_job", "args": {"job_id": "00000000-0000-4000-8000-000000000000"}, "expect": {"ok": false, "error.code": "not_found"}},
  {"tool": "dockhand_get_operation", "args": {"op_id": "00000000-0000-4000-8000-000000000000"}, "expect": {"ok": false, "error.code": "operation_unknown"}},

